@model IEnumerable<TodoListApp.WebApp.Models.TodoListWebApiModel>

@{
    ViewData["Title"] = "Sticky Wall";
    var noteColors = new[] { "note-yellow", "note-blue", "note-pink", "note-orange" };
    int colorIndex = 0;
}

<h1 class="page-title">Sticky Wall</h1>

<div class="sticky-wall">
    @foreach (var list in Model)
    {
        @if (list.AccessLevel != TodoListApp.Data.UserRole.NoAccess)
        {
            var color = noteColors[colorIndex % noteColors.Length];
            colorIndex++;

            <a asp-controller="TodoTask" asp-action="Index" asp-route-todoListId="@list.Id"
               class="sticky-note @color">
                <div class="sticky-note__title">@list.Title</div>
                <div class="sticky-note__body">
                    @if (!string.IsNullOrWhiteSpace(list.Description))
                    {
                        @list.Description
                    }
                    else
                    {
                        <span style="opacity:0.4;">No description</span>
                    }
                </div>
                <div class="sticky-note__footer">
                    <span>
                        @if (list.AccessLevel == TodoListApp.Data.UserRole.Owner)
                        {
                            <span class="badge bg-primary" style="font-size:0.7rem;">Owner</span>
                        }
                        else if (list.AccessLevel == TodoListApp.Data.UserRole.Editor)
                        {
                            <span class="badge bg-success" style="font-size:0.7rem;">Editor</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary" style="font-size:0.7rem;">Viewer</span>
                        }
                    </span>
                </div>
            </a>
        }
    }

    <a asp-action="Create" class="sticky-add-new">+</a>
</div>