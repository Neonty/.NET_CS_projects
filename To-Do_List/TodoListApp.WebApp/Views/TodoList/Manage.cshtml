@model TodoListApp.WebApp.Models.TodoListWebApiModel

@{
    ViewData["Title"] = "Manage Sharing";
}

<div class="page-header">
    <h1 class="page-title">Manage Access for @Model.Title</h1>
</div>

<div class="form-card">
    <h4>Grant Access to a User</h4>
    <form method="post" asp-controller="Share" asp-action="AddUser" class="d-flex gap-2 align-items-end">
        <input type="hidden" name="todoListId" value="@Model.Id" />
        <div class="form-group" style="flex: 1;">
            <label>User Email</label>
            <input type="email" name="userEmail" class="form-control" placeholder="user@example.com" required />
        </div>
        <div class="form-group">
            <label>Role</label>
            <select name="role" class="form-control">
                <option value="Editor">Editor</option>
                <option value="Viewer">Viewer</option>
            </select>
        </div>
        <div class="form-group">
            <button type="submit" class="btn btn-primary">Grant Access</button>
        </div>
    </form>
</div>

@if (ViewBag.SharedUsers != null)
{
    <div class="form-card" style="margin-top: 2rem;">
        <h4>Users with Access</h4>
        @if (ViewBag.SharedUsers.Count > 0)
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in ViewBag.SharedUsers)
                    {
                        <tr>
                            <td>@user.Email</td>
                            <td>@user.Role</td>
                            <td>
                                <form method="post" asp-controller="Share" asp-action="RemoveUser" style="display:inline;">
                                    <input type="hidden" name="todoListId" value="@Model.Id" />
                                    <input type="hidden" name="targetUserId" value="@user.UserId" />
                                    <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted">No users have been granted access yet.</p>
        }
    </div>
}

<div style="margin-top: 2rem;">
    <a asp-action="Index" class="btn btn-ghost">Back to Lists</a>
</div>
