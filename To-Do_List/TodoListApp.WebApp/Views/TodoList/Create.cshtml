@model TodoListApp.WebApp.Models.TodoListWebApiModel

@{
    ViewData["Title"] = "New List";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="shiny-card mt-4">
            <h1 class="page-title mb-4 text-center" style="font-size: 2rem;">New List</h1>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-4">
                    <label asp-for="Title" class="form-label fw-bold">Title</label>
                    <input asp-for="Title" class="shiny-input" placeholder="List title…" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="mb-5">
                    <label asp-for="Description" class="form-label fw-bold">Description</label>
                    <textarea asp-for="Description" class="shiny-input" rows="4" placeholder="What is this list for?"></textarea>
                </div>

                <div class="d-flex gap-3 mt-4">
                    <button type="submit" class="shiny-btn flex-grow-1">Create List</button>
                    <a asp-action="Index" class="shiny-btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>