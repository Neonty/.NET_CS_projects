@model IEnumerable<TodoListApp.WebApp.Models.TodoTask>
@using TodoListApp.WebApp.Models

@{
	ViewData["Title"] = "My Assigned Tasks";
	var statusFilter = ViewBag.StatusFilter as string ?? "Active";
	var sortBy = ViewBag.SortBy as string ?? "DueDate";
}

<div class="page-header">
	<h1 class="page-title">My Assigned Tasks</h1>
	<form asp-controller="Search" asp-action="Index" method="get" class="page-search">
		<input type="text" name="title" placeholder="Search tasks..." aria-label="Search tasks" />
		<button type="submit" class="btn-search">Search</button>
	</form>
</div>

<form method="get" class="task-filter-bar">
	<label for="status">Status</label>
	<select id="status" name="status" class="form-select" onchange="this.form.submit()">
		<option value="Active" selected="@(statusFilter == "Active")">Active</option>
		<option value="Completed" selected="@(statusFilter == "Completed")">Completed</option>
		<option value="All" selected="@(statusFilter == "All")">All</option>
	</select>

	<label for="sortBy">Sort by</label>
	<select id="sortBy" name="sortBy" class="form-select" onchange="this.form.submit()">
		<option value="DueDate" selected="@(sortBy == "DueDate")">Due Date</option>
		<option value="Name" selected="@(sortBy == "Name")">Task Name</option>
	</select>
</form>

<div class="skeleton-wall" aria-hidden="true">
	@for (var i = 0; i < 3; i++)
	{
		<div class="skeleton-card">
			<div class="skeleton-line skeleton-line--title"></div>
			<div class="skeleton-line"></div>
			<div class="skeleton-line"></div>
			<div class="skeleton-line skeleton-line--short"></div>
		</div>
	}
</div>

<div class="page-content">
@if (Model.Any())
{
	<div class="sticky-wall">
		@foreach (var task in Model)
		{
			var isOverdue = task.IsOverdue;
			var statusClass = task.Status.GetStatusCssClass();
			var cardClass = isOverdue ? "sticky-note--overdue" : $"sticky-note--{statusClass.Replace("status-", string.Empty)}";

			<div class="sticky-note @cardClass">
				<a asp-controller="TodoTask" asp-action="Details" asp-route-todoListId="@task.TodoListId" asp-route-id="@task.Id" class="text-decoration-none flex-grow-1" style="color: inherit;">
					<div class="sticky-note__title">@task.Title</div>
					<div class="sticky-note__body">
						@if (!string.IsNullOrWhiteSpace(task.Description))
						{
							@task.Description
						}
						else
						{
							<span class="text-muted">No description</span>
						}
					</div>
				</a>

				<div class="task-card__status-row">
					<form asp-action="ChangeStatus" method="post" class="status-change-form">
						@Html.AntiForgeryToken()
						<input type="hidden" name="todoListId" value="@task.TodoListId" />
						<input type="hidden" name="taskId" value="@task.Id" />
						<input type="hidden" name="statusFilter" value="@statusFilter" />
						<input type="hidden" name="sortBy" value="@sortBy" />
						<select name="newStatus" class="status-badge-select @statusClass" data-status-select>
							@foreach (var statusOption in Enum.GetValues<TodoTaskStatus>())
							{
								<option value="@statusOption" selected="@(statusOption == task.Status)">@statusOption.GetStatusLabel()</option>
							}
						</select>
						<button type="submit" class="btn-update-status">Update</button>
					</form>
				</div>

				@if (task.DueDate.HasValue)
				{
					<div class="sticky-note__footer">
						<span class="sticky-note__due @(isOverdue ? "sticky-note__due--overdue" : "")">
							Due: @task.DueDate.FormatDueDate()
						</span>
					</div>
				}
			</div>
		}
	</div>
}
else
{
	ViewData["EmptyTitle"] = "No tasks found";
	ViewData["EmptyMessage"] = "No tasks match your current filters. Try changing the status filter or search for a specific task.";
	ViewData["EmptyIcon"] = "✅";
	<partial name="_EmptyState" />
}
</div>

@section Scripts {
	<script>
		document.querySelectorAll('[data-status-select]').forEach(function (select) {
			select.addEventListener('change', function () {
				var classes = ['status-notstarted', 'status-inprogress', 'status-completed'];
				classes.forEach(function (c) { select.classList.remove(c); });
				select.classList.add(select.value === 'NotStarted' ? 'status-notstarted'
					: select.value === 'InProgress' ? 'status-inprogress' : 'status-completed');
			});
		});
	</script>
}
