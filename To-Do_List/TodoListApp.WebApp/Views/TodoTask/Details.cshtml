@model TodoListApp.WebApp.Models.TodoTask

@{
	ViewData["Title"] = "Task Details";
}

<h1>Task Details</h1>

<div>
	<hr />
	<dl class="row">
		<dt class="col-sm-2">Title</dt>
		<dd class="col-sm-10">@Model.Title</dd>

		<dt class="col-sm-2">Description</dt>
		<dd class="col-sm-10">@Model.Description</dd>

		<dt class="col-sm-2">Created At</dt>
		<dd class="col-sm-10">@Model.CreatedAt.ToLocalTime().ToString("g")</dd>

		<dt class="col-sm-2">Due Date</dt>
		<dd class="col-sm-10">@(Model.DueDate?.ToLocalTime().ToString("d") ?? "No due date")</dd>

		<dt class="col-sm-2">Assigned To</dt>
		<dd class="col-sm-10">
			@if (string.IsNullOrEmpty(Model.AssigneeEmail))
			{
				<span class="text-muted">Unassigned</span>
			}
			else
			{
				<span class="badge bg-secondary">@Model.AssigneeEmail</span>
			}
		</dd>

		<dt class="col-sm-2">Status</dt>
		<dd class="col-sm-10">@Model.Status</dd>

		<dt class="col-sm-2">Tags</dt>
		<dd class="col-sm-10">
			@if (Model.Tags != null && Model.Tags.Any())
			{
				foreach (var tag in Model.Tags)
				{
					<a asp-controller="Tags" asp-action="Tasks" asp-route-name="@tag" class="badge bg-info text-dark text-decoration-none me-1">@tag</a>
				}
			}
			else
			{
				<span class="text-muted">No tags added.</span>
			}
		</dd>
	</dl>
</div>
<div>
	<a asp-action="Edit" asp-route-todoListId="@Model.TodoListId" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
	<a asp-action="Index" asp-route-todoListId="@Model.TodoListId" class="btn btn-secondary">Back to List</a>
</div>

<partial name="_Comments" model="Model" />
