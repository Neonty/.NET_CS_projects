@model TodoListApp.WebApp.Models.TodoTask

@{
	ViewData["Title"] = "Task Details";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="shiny-card mt-4">
            <div class="d-flex justify-content-between align-items-start mb-4">
                <h1 class="page-title mb-0" style="font-size: 2.2rem; font-weight: 800;">@Model.Title</h1>
                <span class="badge bg-light text-dark fs-6 px-3 py-2 border rounded-pill">@Model.Status</span>
            </div>

            <div class="mb-5">
                <p class="fs-5 text-secondary" style="line-height: 1.6;">
                    @(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)
                </p>
            </div>

            <div class="row g-4 mb-5">
                <div class="col-sm-6">
                    <div class="p-3 bg-light rounded-3 h-100" style="background-color: #f8f9fa;">
                        <h6 class="text-uppercase text-muted fw-bold mb-2" style="font-size: 0.8rem; letter-spacing: 0.5px;">Created At</h6>
                        <p class="mb-0 fw-medium">@Model.CreatedAt.ToLocalTime().ToString("g")</p>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="p-3 bg-light rounded-3 h-100" style="background-color: #f8f9fa;">
                        <h6 class="text-uppercase text-muted fw-bold mb-2" style="font-size: 0.8rem; letter-spacing: 0.5px;">Due Date</h6>
                        <p class="mb-0 fw-medium @(Model.DueDate?.ToLocalTime() < DateTime.Now && Model.Status != TodoListApp.WebApp.Models.TodoTaskStatus.Completed ? "text-danger fw-bold" : "")">
                            @(Model.DueDate?.ToLocalTime().ToString("g") ?? "No due date")
                        </p>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="p-3 bg-light rounded-3 h-100" style="background-color: #f8f9fa;">
                        <h6 class="text-uppercase text-muted fw-bold mb-2" style="font-size: 0.8rem; letter-spacing: 0.5px;">Assigned To</h6>
                        @if (string.IsNullOrEmpty(Model.AssigneeEmail))
                        {
                            <span class="text-muted fw-medium">Unassigned</span>
                        }
                        else
                        {
                            <span class="fw-bold text-primary">@Model.AssigneeEmail</span>
                        }
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="p-3 bg-light rounded-3 h-100" style="background-color: #f8f9fa;">
                        <h6 class="text-uppercase text-muted fw-bold mb-3" style="font-size: 0.8rem; letter-spacing: 0.5px;">Tags</h6>
                        <div>
                            @if (Model.Tags != null && Model.Tags.Any())
                            {
                                foreach (var tag in Model.Tags)
                                {
                                    <a asp-controller="Tags" asp-action="Tasks" asp-route-name="@tag" class="shiny-tag-pill me-2 mb-2 px-3 py-1 fs-6" style="padding: 0.4rem 1rem;">#@tag</a>
                                }
                            }
                            else
                            {
                                <span class="text-muted fw-medium">No tags added.</span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-3 pt-3 border-top">
                @if (ViewBag.CanEdit == true)
                {
                    <a asp-action="Edit" asp-route-todoListId="@Model.TodoListId" asp-route-id="@Model.Id" class="shiny-btn px-4">Edit Task</a>
                }
                <a asp-action="Index" asp-route-todoListId="@Model.TodoListId" class="shiny-btn-secondary px-4">Back to List</a>
            </div>
        </div>
        
        <div class="mt-4">
            <partial name="_Comments" model="Model" />
        </div>
    </div>
</div>
