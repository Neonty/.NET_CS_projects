@model TodoListApp.WebApp.Models.TodoTask

@{
	ViewData["Title"] = "New Task";
	var todoListId = (int)ViewBag.TodoListId;
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="shiny-card mt-4">
            <h1 class="page-title mb-4 text-center" style="font-size: 2rem;">New Task</h1>

            <form asp-action="Create" asp-route-todoListId="@todoListId" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="TodoListId" value="@todoListId" />

                <div class="mb-4">
                    <label asp-for="Title" class="form-label fw-bold"></label>
                    <input asp-for="Title" class="shiny-input" placeholder="Task title…" />
                    <span asp-validation-for="Title" class="field-error"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label fw-bold"></label>
                    <textarea asp-for="Description" class="shiny-input" rows="4" placeholder="What needs to be done?"></textarea>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <label asp-for="DueDate" class="form-label fw-bold">Due Date</label>
                        <input asp-for="DueDate" type="date" class="shiny-input" />
                    </div>
                    <div class="col-md-6 mt-4 mt-md-0">
                        <label asp-for="Status" class="form-label fw-bold"></label>
                        <select asp-for="Status" class="shiny-input" asp-items="Html.GetEnumSelectList<TodoListApp.WebApp.Models.TodoTaskStatus>()"></select>
                    </div>
                </div>

                <div class="d-flex gap-3 mt-5">
                    <button type="submit" class="shiny-btn flex-grow-1">Create Task</button>
                    <a asp-action="Index" asp-route-todoListId="@todoListId" class="shiny-btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>