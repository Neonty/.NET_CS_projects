@model TodoListApp.WebApp.Models.TodoTask

@{
	ViewData["Title"] = "New Task";
	var todoListId = (int)ViewBag.TodoListId;
}

<div class="page-header">
	<h1 class="page-title">New Task</h1>
</div>

<div class="form-card">
	<form asp-action="Create" asp-route-todoListId="@todoListId" method="post">
		@Html.AntiForgeryToken()
		<input type="hidden" asp-for="TodoListId" value="@todoListId" />

		<div class="form-group">
			<label asp-for="Title">Title</label>
			<input asp-for="Title" class="form-control" placeholder="Task title…" />
			<span asp-validation-for="Title" class="field-error"></span>
		</div>

		<div class="form-group">
			<label asp-for="Description">Description</label>
			<textarea asp-for="Description" class="form-control" rows="3"
					  placeholder="What needs to be done?"></textarea>
		</div>

		<div class="form-group">
			<label asp-for="DueDate">Due Date</label>
			<input asp-for="DueDate" type="date" class="form-control" />
		</div>

		<div class="form-group">
			<label asp-for="Status">Status</label>
			<select asp-for="Status" class="form-control"
					asp-items="Html.GetEnumSelectList<TodoListApp.WebApp.Models.TodoTaskStatus>()">
			</select>
		</div>

		<div class="form-actions">
			<button type="submit" class="btn btn-primary">Create</button>
			<a asp-action="Index" asp-route-todoListId="@todoListId" class="btn btn-ghost">Cancel</a>
		</div>
	</form>
</div>