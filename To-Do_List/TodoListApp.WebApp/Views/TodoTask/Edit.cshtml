@model TodoListApp.WebApp.Models.TodoTask

@{
	ViewData["Title"] = "Edit Task";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="shiny-card mt-4">
            <h1 class="page-title mb-4 text-center" style="font-size: 2rem;">Edit Task</h1>

            <form asp-action="Edit">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="TodoListId"/>

                <div class="mb-4">
                    <label asp-for="Title" class="form-label fw-bold">Title</label>
                    <input asp-for="Title" class="shiny-input"/>
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label fw-bold">Description</label>
                    <textarea asp-for="Description" class="shiny-input" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <label asp-for="DueDate" class="form-label fw-bold">Due Date</label>
                        <input asp-for="DueDate" type="date" class="shiny-input" />
                        <span asp-validation-for="DueDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mt-4 mt-md-0">
                        <label asp-for="Status" class="form-label fw-bold">Status</label>
                        <select asp-for="Status" class="shiny-input">
                            @foreach (var status in Enum.GetValues<TodoListApp.WebApp.Models.TodoTaskStatus>())
                            {
                                <option value="@status">@status</option>
                            }
                        </select>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="AssigneeEmail" class="form-label fw-bold">Assigned To</label>
                    <input asp-for="AssigneeEmail" class="shiny-input" placeholder="e.g. user@example.com" />
                    <span asp-validation-for="AssigneeEmail" class="text-danger"></span>
                    <small class="text-muted d-block mt-2">Leave blank to unassign, or type an email to reassign.</small>
                </div>

                <div class="mb-5">
                    <label asp-for="TagsString" class="form-label fw-bold">Tags (comma-separated)</label>
                    <input asp-for="TagsString" class="shiny-input" placeholder="e.g. urgent, frontend, review" />
                    <span asp-validation-for="TagsString" class="text-danger"></span>
                    <small class="text-muted d-block mt-2">Separate multiple tags with a comma.</small>
                </div>

                <div class="d-flex gap-3 mt-4">
                    <input type="submit" value="Save Changes" class="shiny-btn flex-grow-1" />
                    <a asp-action="Index" asp-route-todoListId="@Model.TodoListId" class="shiny-btn-secondary">Back to List</a>
                </div>
            </form>
        </div>
        
        <div class="mt-4">
            <partial name="_Comments" model="Model" />
        </div>
    </div>
</div>
