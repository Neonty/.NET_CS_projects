@model TodoListApp.WebApp.Models.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="shiny-card mx-auto" style="max-width: 450px;">
            <div class="card-body p-2">
                <h2 class="card-title text-center mb-5" style="font-weight: 700; font-size: 2rem;">Create account</h2>

                <form method="post" asp-action="Register" asp-controller="Account">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label fw-bold"></label>
                        <input asp-for="Email" class="shiny-input" placeholder="name@example.com" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label fw-bold"></label>
                        <input asp-for="Password" class="shiny-input" placeholder="At least 8 characters" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-bold"></label>
                        <input asp-for="ConfirmPassword" class="shiny-input" placeholder="Re-enter your password" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <button type="submit" class="shiny-btn w-100 mb-4 py-3">Register</button>
                </form>

                <hr style="opacity: 0.1; margin: 2rem 0;" />

                <p class="text-center mb-0" style="font-size: 1.05rem;">
                    Already have an account? <br/>
                    <a asp-controller="Account" asp-action="Login" class="shiny-btn-secondary mt-3">Log in</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
