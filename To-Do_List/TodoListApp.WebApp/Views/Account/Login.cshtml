@model TodoListApp.WebApp.Models.LoginViewModel

@{
    ViewData["Title"] = "Log in";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="shiny-card mx-auto" style="max-width: 450px;">
            <div class="card-body p-2">
                <h2 class="card-title text-center mb-5" style="font-weight: 700; font-size: 2rem;">Log in</h2>

                <form method="post" asp-action="Login" asp-controller="Account">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label fw-bold"></label>
                        <input asp-for="Email" class="shiny-input" placeholder="name@example.com" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label fw-bold"></label>
                        <input asp-for="Password" class="shiny-input" placeholder="Password" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="mb-4 form-check">
                        <input asp-for="RememberMe" class="form-check-input" style="cursor: pointer;" />
                        <label asp-for="RememberMe" class="form-check-label" style="cursor: pointer;"></label>
                    </div>

                    <button type="submit" class="shiny-btn w-100 mb-4 py-3">Log in</button>
                </form>

                <hr style="opacity: 0.1; margin: 2rem 0;" />

                <p class="text-center mb-0" style="font-size: 1.05rem;">
                    Don't have an account? <br/>
                    <a asp-controller="Account" asp-action="Register" class="shiny-btn-secondary mt-3">Register here</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
