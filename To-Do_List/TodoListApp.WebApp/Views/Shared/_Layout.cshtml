<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - TodoListApp.WebApp</title>
	<script type="importmap"></script>
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/TodoListApp.WebApp.styles.css" asp-append-version="true" />
</head>
<body>
	<div id="page-loader" class="page-loader hidden" role="status" aria-label="Loading">
		<div class="spinner-border" role="status">
			<span class="visually-hidden">Loading...</span>
		</div>
	</div>
	<div class="dashboard-container">
		<aside class="dashboard-sidebar" id="app-sidebar">
			@await Component.InvokeAsync("Sidebar")
		</aside>
		
		<main role="main" class="dashboard-main">
            <div style="margin-bottom: 2rem;">
                <span id="sidebar-toggle-btn" style="cursor:pointer; font-size:1.5rem; display:none; line-height: 1;">&#9776;</span>
            </div>
			@RenderBody()
		</main>
	</div>

	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var sidebar = document.getElementById("app-sidebar");
            var toggleInside = document.getElementById("sidebar-toggle-inside");
            var toggleBtn = document.getElementById("sidebar-toggle-btn");

            if(toggleInside && sidebar && toggleBtn) {
                toggleInside.addEventListener("click", function() {
                    sidebar.classList.add("collapsed");
                    toggleBtn.style.display = "inline-block";
                });
            }

            if(toggleBtn && sidebar) {
                toggleBtn.addEventListener("click", function() {
                    sidebar.classList.remove("collapsed");
                    toggleBtn.style.display = "none";
                });
            }
        });
    </script>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>