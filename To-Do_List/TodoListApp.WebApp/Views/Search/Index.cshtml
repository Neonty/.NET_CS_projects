@model IEnumerable<TodoListApp.WebApp.Models.TodoTask>
@using TodoListApp.WebApp.Models

@{
	ViewData["Title"] = "Search Tasks";
	var hasSearched = !string.IsNullOrEmpty(ViewBag.TitleFilter) || !string.IsNullOrEmpty(ViewBag.DateFromFilter) || !string.IsNullOrEmpty(ViewBag.DateToFilter) || !string.IsNullOrEmpty(ViewBag.StatusFilter) || !string.IsNullOrEmpty(ViewBag.SortByFilter);
}

<div class="page-header">
	<h1 class="page-title">Search Tasks</h1>
</div>

<div class="task-filter-bar" style="flex-direction: column; align-items: stretch; gap: 1rem;">
	<form method="get" asp-action="Index" style="display:flex; flex-wrap:wrap; gap:1rem; align-items:flex-end;">
		<div style="flex:1; min-width:160px;">
			<label for="title" class="form-label fw-bold" style="font-size:0.82rem;">Task Title</label>
			<input type="text" class="form-control" id="title" name="title" value="@ViewBag.TitleFilter" placeholder="Keyword in title" />
		</div>
		<div style="min-width:140px;">
			<label for="dateFrom" class="form-label fw-bold" style="font-size:0.82rem;">Date From</label>
			<input type="date" class="form-control" id="dateFrom" name="dateFrom" value="@ViewBag.DateFromFilter" />
		</div>
		<div style="min-width:140px;">
			<label for="dateTo" class="form-label fw-bold" style="font-size:0.82rem;">Date To</label>
			<input type="date" class="form-control" id="dateTo" name="dateTo" value="@ViewBag.DateToFilter" />
		</div>
		<div style="min-width:130px;">
			<label for="status" class="form-label fw-bold" style="font-size:0.82rem;">Status</label>
			<select class="form-select" id="status" name="status">
				<option value="">Any</option>
				<option value="NotStarted" selected="@(ViewBag.StatusFilter == "NotStarted")">Not Started</option>
				<option value="InProgress" selected="@(ViewBag.StatusFilter == "InProgress")">In Progress</option>
				<option value="Completed" selected="@(ViewBag.StatusFilter == "Completed")">Completed</option>
			</select>
		</div>
		<div style="min-width:160px;">
			<label for="sortBy" class="form-label fw-bold" style="font-size:0.82rem;">Sort By</label>
			<select class="form-select" id="sortBy" name="sortBy">
				<option value="CreatedAt" selected="@(ViewBag.SortByFilter == "CreatedAt" || string.IsNullOrEmpty(ViewBag.SortByFilter))">Created Date (Desc)</option>
				<option value="CreatedAtAsc" selected="@(ViewBag.SortByFilter == "CreatedAtAsc")">Created Date (Asc)</option>
				<option value="DueDate" selected="@(ViewBag.SortByFilter == "DueDate")">Due Date (Asc)</option>
				<option value="DueDateDesc" selected="@(ViewBag.SortByFilter == "DueDateDesc")">Due Date (Desc)</option>
				<option value="Title" selected="@(ViewBag.SortByFilter == "Title")">Title (Asc)</option>
				<option value="TitleDesc" selected="@(ViewBag.SortByFilter == "TitleDesc")">Title (Desc)</option>
				<option value="Status" selected="@(ViewBag.SortByFilter == "Status")">Status (Asc)</option>
				<option value="StatusDesc" selected="@(ViewBag.SortByFilter == "StatusDesc")">Status (Desc)</option>
			</select>
		</div>
		<button type="submit" class="btn-update-status" style="padding:0.5rem 1.25rem;">Search</button>
		@if (hasSearched)
		{
			<a asp-action="Index" class="btn btn-sm btn-outline-secondary" style="padding:0.5rem 1rem;">Clear</a>
		}
	</form>
</div>

@if (hasSearched)
{
	<h4 class="mb-3" style="font-weight: 700;">Search Results</h4>

	<div class="page-content">
    <div class="sticky-wall">
        @foreach (var task in Model)
        {
            var isOverdue = task.IsOverdue;
            var statusKey = task.Status.GetStatusCssClass().Replace("status-", string.Empty);
            var cardClass = isOverdue ? "sticky-note--overdue" : $"sticky-note--{statusKey}";

            <a asp-controller="TodoTask" asp-action="Details" asp-route-todoListId="@task.TodoListId" asp-route-id="@task.Id" class="sticky-note @cardClass text-decoration-none">
                <div class="sticky-note__title">
                    @task.Title
                    @if (isOverdue)
                    {
                        <span class="badge bg-danger ms-2" style="font-size: 0.7rem; vertical-align: middle;">OVERDUE</span>
                    }
                </div>
                <div class="sticky-note__body">
                    @if (!string.IsNullOrWhiteSpace(task.Description))
                    {
                        @task.Description
                    }
                    else
                    {
                        <span class="text-muted">No description</span>
                    }
                </div>
                <div class="sticky-note__footer" style="justify-content:space-between;">
                    <span class="status-badge-select @task.Status.GetStatusCssClass()" style="pointer-events:none; padding-right:0.75rem;">@task.Status.GetStatusLabel()</span>
                    @if (task.DueDate.HasValue)
                    {
                        <span class="sticky-note__due @(isOverdue ? "sticky-note__due--overdue" : "")">
                            Due: @task.DueDate.FormatDueDate()
                        </span>
                    }
                </div>
            </a>
        }
    </div>

    @if (!Model.Any())
    {
        ViewData["EmptyTitle"] = "No results";
        ViewData["EmptyMessage"] = "No tasks found matching your search criteria. Try different keywords or filters.";
        ViewData["EmptyIcon"] = "🔍";
        <partial name="_EmptyState" />
    }
	</div>
}
else
{
    ViewData["EmptyTitle"] = "Search your tasks";
    ViewData["EmptyMessage"] = "Use the filters above to find tasks by title, date, or status.";
    ViewData["EmptyIcon"] = "🔍";
    <partial name="_EmptyState" />
}
