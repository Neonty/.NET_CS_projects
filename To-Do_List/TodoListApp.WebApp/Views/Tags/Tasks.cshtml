@model IEnumerable<TodoListApp.WebApp.Models.TodoTask>
@using TodoListApp.WebApp.Models

@{
	ViewData["Title"] = $"Tasks tagged with '{ViewBag.TagName}'";
}

<div class="page-header">
	<h1 class="page-title mb-0">Tasks tagged with <span class="badge bg-info text-dark">@ViewBag.TagName</span></h1>
</div>

<div class="page-content">
@if (Model.Any())
{
    <div class="sticky-wall">
        @foreach (var task in Model)
        {
            var isOverdue = task.IsOverdue;
            var statusKey = task.Status.GetStatusCssClass().Replace("status-", string.Empty);
            var cardClass = isOverdue ? "sticky-note--overdue" : $"sticky-note--{statusKey}";

            <a asp-controller="TodoTask" asp-action="Details" asp-route-todoListId="@task.TodoListId" asp-route-id="@task.Id"
               class="sticky-note @cardClass">
                <div class="sticky-note__title">@task.Title</div>
                <div class="sticky-note__body">
                    @if (!string.IsNullOrWhiteSpace(task.Description))
                    {
                        @task.Description
                    }
                    else
                    {
                        <span class="text-muted">No description</span>
                    }
                </div>
                <div class="sticky-note__footer" style="justify-content:space-between;">
                    <span class="status-badge-select @task.Status.GetStatusCssClass()" style="pointer-events:none; padding-right:0.75rem;">@task.Status.GetStatusLabel()</span>
                    @if (task.DueDate.HasValue)
                    {
                        <span class="sticky-note__due @(isOverdue ? "sticky-note__due--overdue" : "")">
                            Due: @task.DueDate.FormatDueDate()
                        </span>
                    }
                </div>
            </a>
        }
    </div>
}
else
{
    ViewData["EmptyTitle"] = "No tagged tasks";
    ViewData["EmptyMessage"] = $"No tasks found with the tag \"{ViewBag.TagName}\".";
    ViewData["EmptyIcon"] = "🏷️";
    <partial name="_EmptyState" />
}
</div>
