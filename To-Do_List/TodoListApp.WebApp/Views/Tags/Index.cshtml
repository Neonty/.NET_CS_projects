@model IEnumerable<string>

@{
	ViewData["Title"] = "All Tags";
}

<h1>All Tags</h1>
<p class="text-muted">Select a tag to view all associated tasks.</p>

<div class="mt-4">
	@if (Model != null && Model.Any())
	{
		@foreach (var tag in Model)
		{
			<a asp-controller="Tags" asp-action="Tasks" asp-route-name="@tag" class="btn btn-outline-primary m-1">
				@tag
			</a>
		}
	}
	else
	{
		<div class="alert alert-info">There are currently no tags created in the system.</div>
	}
</div>